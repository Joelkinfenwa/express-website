{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/products/:path*",
      "destination": "https://shop.expresspathology.com.au/products/:path*",
      "permanent": true
    },
    {
      "source": "/collections/:path*",
      "destination": "https://shop.expresspathology.com.au/collections/:path*",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "https://shop.expresspathology.com.au/pages/:path*",
      "permanent": true
    },
    {
      "source": "/blogs/:path*",
      "destination": "https://shop.expresspathology.com.au/blogs/:path*",
      "permanent": true
    },
    {
      "source": "/policies/:path*",
      "destination": "https://shop.expresspathology.com.au/policies/:path*",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "https://shop.expresspathology.com.au/cart",
      "permanent": false
    },
    {
      "source": "/cart/:path*",
      "destination": "https://shop.expresspathology.com.au/cart/:path*",
      "permanent": false
    },
    {
      "source": "/account",
      "destination": "https://shop.expresspathology.com.au/account",
      "permanent": false
    },
    {
      "source": "/account/:path*",
      "destination": "https://shop.expresspathology.com.au/account/:path*",
      "permanent": false
    },
    {
      "source": "/checkouts/:path*",
      "destination": "https://shop.expresspathology.com.au/checkouts/:path*",
      "permanent": false
    },
    {
      "source": "/apps/:path*",
      "destination": "https://shop.expresspathology.com.au/apps/:path*",
      "permanent": false
    },
    {
      "source": "/search",
      "destination": "https://shop.expresspathology.com.au/search",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tests/vitamin-d-test",
      "destination": "/tests?add=vitamin-d#build",
      "permanent": true
    },
    {
      "source": "/tests/hba1c",
      "destination": "/tests?add=hba1c#build",
      "permanent": true
    },
    {
      "source": "/tests/hep-b-antigen",
      "destination": "/tests?add=hep-b-antigen#build",
      "permanent": true
    },
    {
      "source": "/tests/hep-c-antibody",
      "destination": "/tests?add=hep-c-antibody#build",
      "permanent": true
    },
    {
      "source": "/tests/hiv",
      "destination": "/tests?add=hiv#build",
      "permanent": true
    },
    {
      "source": "/tests/kidney-function-test",
      "destination": "/tests?add=kidney-function#build",
      "permanent": true
    },
    {
      "source": "/tests/lipid-profile",
      "destination": "/tests?add=lipid-profile#build",
      "permanent": true
    },
    {
      "source": "/tests/lft-s-liver-function-test",
      "destination": "/tests?add=liver-function#build",
      "permanent": true
    },
    {
      "source": "/tests/full-blood-count",
      "destination": "/tests?add=full-blood-count-and-esr#build",
      "permanent": true
    },
    {
      "source": "/tests/general-biochemistry",
      "destination": "/tests?add=general-biochemistry#build",
      "permanent": true
    },
    {
      "source": "/tests/iron-studies",
      "destination": "/tests?add=iron-studies#build",
      "permanent": true
    },
    {
      "source": "/tests/psa-prostate-specific-antigen-test",
      "destination": "/tests?add=psa#build",
      "permanent": true
    },
    {
      "source": "/tests/cortisol-test",
      "destination": "/tests?add=cortisol#build",
      "permanent": true
    },
    {
      "source": "/tests/blood-insulin-levels",
      "destination": "/tests?add=fasting-insulin#build",
      "permanent": true
    },
    {
      "source": "/tests/core-hormone-check",
      "destination": "/tests/male-hormonal-test",
      "permanent": true
    },
    {
      "source": "/tests/thyroid-antigen",
      "destination": "/tests/extensive-thyroid-panel",
      "permanent": true
    },
    {
      "source": "/tests/thyroid-function-tests-1",
      "destination": "/tests/extensive-thyroid-panel",
      "permanent": true
    },
    {
      "source": "/tests/vitamin-d-b12-test",
      "destination": "/tests?add=vitamin-d,vitamin-b12#build",
      "permanent": true
    },
    {
      "source": "/tests/extended-general-health-check",
      "destination": "/tests/core-health-check",
      "permanent": true
    },
    {
      "source": "/tests/optimisation-panel",
      "destination": "/tests/male-hormonal-test",
      "permanent": true
    },
    {
      "source": "/tests/vitamin-wellness-panel",
      "destination": "/tests?add=vitamin-d,vitamin-b12#build",
      "permanent": true
    },
    {
      "source": "/tests/elite-health-assessment",
      "destination": "/tests/complete-wellness-panel",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
